#!/bin/bash

set -euo pipefail

SCRIPT_PATH="$(python3 - <<'PY' "${BASH_SOURCE[0]}"
from pathlib import Path
import sys
print(Path(sys.argv[1]).resolve())
PY
)"
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"

ANCHOR_NAME="utun-killswitch"
ANCHOR_PATH="/etc/pf.anchors/${ANCHOR_NAME}"
PF_CONF="/etc/pf.conf"
WAN_IF="en0"
LAUNCHD_LABEL="com.mxl.killswitch"
LAUNCHD_PLIST="/Library/LaunchDaemons/${LAUNCHD_LABEL}.plist"
STAGED_LAUNCHD_PLIST="${SCRIPT_DIR}/${LAUNCHD_LABEL}.plist"

usage() {
  cat <<'EOF'
Usage: killswitch <command>

Commands:
  enable      Enable the daemon and apply the current kill switch state
  disable     Disable the daemon and disable the kill switch anchor
  status      Show current kill switch and monitor status
  test        Validate current kill switch behavior

Use `install-killswitch.sh` for the initial install or reinstall.
Use `uninstall-killswitch.sh` to remove the installed setup.
EOF
}

require_root() {
  if [[ ${EUID} -ne 0 ]]; then
    echo "Please run with sudo: sudo $0 $1"
    exit 1
  fi
}

run_pfctl_quietly() {
  local cmd_desc="$1"
  shift
  local output

  if ! output="$($@ 2>&1)"; then
    printf '%s\n' "$output" >&2
    echo "Failed to ${cmd_desc}." >&2
    exit 1
  fi
}

have_sudo() {
  sudo -n true >/dev/null 2>&1
}

print_header() {
  printf '\n== %s ==\n' "$1"
}

red() {
  printf '\033[31m%s\033[0m\n' "$*"
}

yellow() {
  printf '\033[33m%s\033[0m\n' "$*"
}

green() {
  printf '\033[32m%s\033[0m\n' "$*"
}

pf_conf_has_anchor() {
  [[ -f "$PF_CONF" ]] && \
    grep -Fq "anchor \"${ANCHOR_NAME}\"" "$PF_CONF" && \
    grep -Fq "load anchor \"${ANCHOR_NAME}\" from \"${ANCHOR_PATH}\"" "$PF_CONF"
}

anchor_file_exists() {
  [[ -f "$ANCHOR_PATH" ]]
}

pf_is_enabled() {
  if [[ ${EUID} -eq 0 ]]; then
    pfctl -s info 2>/dev/null | grep -Fq "Status: Enabled"
  elif have_sudo; then
    sudo -n pfctl -s info 2>/dev/null | grep -Fq "Status: Enabled"
  else
    return 2
  fi
}

anchor_is_loaded() {
  if [[ ${EUID} -eq 0 ]]; then
    pfctl -a "$ANCHOR_NAME" -sr >/dev/null 2>&1
  elif have_sudo; then
    sudo -n pfctl -a "$ANCHOR_NAME" -sr >/dev/null 2>&1
  else
    return 2
  fi
}

launchdaemon_is_loaded() {
  if [[ ${EUID} -eq 0 ]]; then
    launchctl print "system/${LAUNCHD_LABEL}" >/dev/null 2>&1
  elif have_sudo; then
    sudo -n launchctl print "system/${LAUNCHD_LABEL}" >/dev/null 2>&1
  else
    return 2
  fi
}

installed_runtime_exists() {
  [[ -x "/usr/local/libexec/killswitch/killswitch" ]] && \
    [[ -x "/usr/local/libexec/killswitch/killswitch-monitor" ]]
}

print_health_line() {
  local status="$1"
  shift

  case "$status" in
    PASS)
      green "PASS: $*"
      ;;
    WARN)
      yellow "WARN: $*"
      ;;
    FAIL)
      red "FAIL: $*"
      ;;
  esac
}

check_setup_health() {
  local broken=0 rc

  if [[ -f "$PF_CONF" ]]; then
    print_health_line PASS "PF config exists: ${PF_CONF}"
  else
    print_health_line FAIL "PF config does not exist: ${PF_CONF}"
    broken=1
  fi

  if pf_conf_has_anchor; then
    print_health_line PASS "${PF_CONF} loads anchor \"${ANCHOR_NAME}\""
  else
    print_health_line FAIL "${PF_CONF} does not load anchor \"${ANCHOR_NAME}\""
    broken=1
  fi

  if anchor_file_exists; then
    print_health_line PASS "Anchor file exists: ${ANCHOR_PATH}"
    if [[ -r "$ANCHOR_PATH" ]]; then
      print_health_line PASS "Anchor file is readable"
    else
      print_health_line WARN "Anchor file is not readable. Run with sudo for full details."
    fi
  else
    print_health_line FAIL "Anchor file does not exist: ${ANCHOR_PATH}"
    broken=1
  fi

  pf_is_enabled
  rc=$?
  if [[ $rc -eq 0 ]]; then
    print_health_line PASS "PF is enabled"
  elif [[ $rc -eq 2 ]]; then
    print_health_line WARN "Unable to read PF status without sudo"
  else
    print_health_line FAIL "PF is not enabled"
    broken=1
  fi

  anchor_is_loaded
  rc=$?
  if [[ $rc -eq 0 ]]; then
    print_health_line PASS "PF anchor \"${ANCHOR_NAME}\" is loaded"
  elif [[ $rc -eq 2 ]]; then
    print_health_line WARN "Unable to verify loaded PF anchor without sudo"
  else
    print_health_line FAIL "PF anchor \"${ANCHOR_NAME}\" is not loaded"
    broken=1
  fi

  if installed_runtime_exists; then
    print_health_line PASS "Installed runtime files are present"
  else
    print_health_line FAIL "Installed runtime files are missing or not executable"
    broken=1
  fi

  if [[ -f "$LAUNCHD_PLIST" ]]; then
    print_health_line PASS "LaunchDaemon plist exists: ${LAUNCHD_PLIST}"
  else
    print_health_line WARN "LaunchDaemon plist is not installed: ${LAUNCHD_PLIST}"
  fi

  launchdaemon_is_loaded
  rc=$?
  if [[ $rc -eq 0 ]]; then
    print_health_line PASS "LaunchDaemon is loaded"
  elif [[ $rc -eq 2 ]]; then
    print_health_line WARN "Unable to verify LaunchDaemon without sudo"
  else
    print_health_line WARN "LaunchDaemon is not loaded"
  fi

  if [[ $broken -ne 0 ]]; then
    red "Kill switch setup is broken. Public traffic may not be protected."
    red "Run: sudo ./install-killswitch.sh"
    red "Then: sudo killswitch enable"
  fi

  return "$broken"
}

require_anchor_installed() {
  if ! pf_conf_has_anchor; then
    red "Kill switch setup is incomplete: ${PF_CONF} does not load anchor \"${ANCHOR_NAME}\"."
    red "Run: sudo ./install-killswitch.sh"
    exit 1
  fi
}

utun_is_active() {
  netstat -rn -f inet | awk '
    $4 ~ /^utun/ && ($1 == "default" || $1 == "0/1" || $1 == "128.0/1") { found = 1 }
    END { exit found ? 0 : 1 }
  '
}

current_mode() {
  if [[ -r "$ANCHOR_PATH" ]]; then
    awk '/^# mode: / { print $3; exit }' "$ANCHOR_PATH" || true
  fi
}

detect_protected_interfaces() {
  local iface
  local -a protected=()

  while read -r iface; do
    [[ -z "$iface" ]] && continue
    case "$iface" in
      lo0|utun*|gif*|stf*|anpi*|awdl*|llw*|ap*|bridge*)
        continue
        ;;
    esac

    if ifconfig "$iface" 2>/dev/null | grep -q 'status: active'; then
      protected+=("$iface")
    fi
  done < <(ifconfig -l | tr ' ' '\n')

  if [[ ${#protected[@]} -eq 0 ]]; then
    echo "Could not detect any active non-utun interfaces to protect."
    exit 1
  fi

  printf '%s\n' "${protected[@]}"
}

build_local_rules() {
  local iface ip mask cidr
  local -a interfaces=("$@")

  for iface in "${interfaces[@]}"; do
    ip="$(ipconfig getifaddr "$iface" 2>/dev/null || true)"
    mask="$(ipconfig getoption "$iface" subnet_mask 2>/dev/null || true)"

    if [[ -n "$ip" && -n "$mask" ]]; then
      cidr="$(python3 - <<'PY' "$ip" "$mask"
import ipaddress
import sys
iface = ipaddress.IPv4Interface(f"{sys.argv[1]}/{sys.argv[2]}")
print(iface.network.with_prefixlen)
PY
)"
      printf 'pass out quick on %s to { 127.0.0.0/8, 169.254.0.0/16, %s } keep state\n' "$iface" "$cidr"
    else
      printf 'pass out quick on %s to { 127.0.0.0/8, 169.254.0.0/16 } keep state\n' "$iface"
    fi
  done
}

write_allow_anchor() {
  cat > "$ANCHOR_PATH" <<'EOF'
# mode: allow
# At least one utun interface is active, so pf does not restrict non-local traffic.
EOF
  chmod 600 "$ANCHOR_PATH"
}

write_block_anchor() {
  local -a protected_ifaces=("$@")

  cat > "$ANCHOR_PATH" <<'EOF'
# mode: block
set block-policy drop
set skip on lo0
EOF

  build_local_rules "${protected_ifaces[@]}" >> "$ANCHOR_PATH"

  for iface in "${protected_ifaces[@]}"; do
    printf 'block drop out quick on %s all\n' "$iface" >> "$ANCHOR_PATH"
  done

  chmod 600 "$ANCHOR_PATH"
}

cmd_sync_internal() {
  local iface mode
  local -a protected_ifaces=()

  require_root __sync

  while read -r iface; do
    [[ -z "$iface" ]] && continue
    protected_ifaces+=("$iface")
  done < <(detect_protected_interfaces)

  if utun_is_active; then
    mode="allow"
    write_allow_anchor
  else
    mode="block"
    write_block_anchor "${protected_ifaces[@]}"
  fi

  run_pfctl_quietly "validate pf config" pfctl -nf "$PF_CONF"
  run_pfctl_quietly "reload pf config" pfctl -f "$PF_CONF"
  pfctl -e >/dev/null 2>&1 || true

  echo "Kill switch synced."
  echo "Mode: ${mode}"
  echo "Protected non-utun interfaces: ${protected_ifaces[*]}"
  if [[ "$mode" == "allow" ]]; then
    echo "An active utun route was detected, so non-local traffic is allowed."
  else
    echo "No active utun route was detected, so non-local traffic is blocked on protected interfaces."
  fi
}

cmd_enable() {
  require_root enable
  require_anchor_installed

  if [[ ! -f "$STAGED_LAUNCHD_PLIST" ]]; then
    red "Missing staged LaunchDaemon plist ${STAGED_LAUNCHD_PLIST}. Run sudo ./install-killswitch.sh first."
    exit 1
  fi

  cp "$STAGED_LAUNCHD_PLIST" "$LAUNCHD_PLIST"
  chown root:wheel "$LAUNCHD_PLIST"
  chmod 644 "$LAUNCHD_PLIST"

  "$0" __sync
  launchctl unload "$LAUNCHD_PLIST" >/dev/null 2>&1 || true
  launchctl load -w "$LAUNCHD_PLIST"
  echo "Kill switch daemon enabled."

  print_header "Setup Health"
  check_setup_health || true
}

cmd_disable() {
  require_root disable
  if ! pf_conf_has_anchor; then
    yellow "PF anchor is not installed in ${PF_CONF}; PF rules may already be inactive."
  fi

  launchctl unload "$LAUNCHD_PLIST" >/dev/null 2>&1 || true
  rm -f "$LAUNCHD_PLIST"

  cat > "$ANCHOR_PATH" <<'EOF'
# Kill switch disabled.
EOF

  chmod 600 "$ANCHOR_PATH"
  run_pfctl_quietly "validate pf config" pfctl -nf "$PF_CONF"
  run_pfctl_quietly "reload pf config" pfctl -f "$PF_CONF"
  pfctl -e >/dev/null 2>&1 || true

  echo "Kill switch daemon disabled."
  echo "Kill switch disabled."

  print_header "Setup Health"
  check_setup_health || true
}

cmd_status() {
  local mode

  print_header "Setup Health"
  check_setup_health || true

  print_header "Config"
  echo "Anchor: ${ANCHOR_NAME}"
  echo "Anchor path: ${ANCHOR_PATH}"
  echo "PF config: ${PF_CONF}"
  echo "Primary WAN interface: ${WAN_IF}"

  print_header "utun State"
  if utun_is_active; then
    echo "Active utun route detected: yes"
  else
    echo "Active utun route detected: no"
  fi
  mode="$(current_mode)"
  echo "Anchor mode: ${mode:-unknown}"

  print_header "Detected utun Interfaces"
  /sbin/ifconfig | awk '/^utun[0-9]+:/{sub(":","",$1); print $1}' || true

  print_header "Detected Active Non-utun Interfaces"
  /sbin/ifconfig -l | tr ' ' '\n' | while read -r iface; do
    [[ -z "$iface" ]] && continue
    case "$iface" in
      lo0|utun*|gif*|stf*|anpi*|awdl*|llw*|ap*|bridge*)
        continue
        ;;
    esac
    if /sbin/ifconfig "$iface" 2>/dev/null | grep -q 'status: active'; then
      echo "$iface"
    fi
  done

  print_header "PF Status"
  if have_sudo && sudo pfctl -s info >/dev/null 2>&1; then
    sudo pfctl -s info | sed -n '1,20p'
  else
    echo "Unable to read pf status without elevated access. Run with sudo for full details."
  fi

  print_header "Monitor Status"
  echo "LaunchDaemon plist: ${LAUNCHD_PLIST}"
  if [[ -f "$LAUNCHD_PLIST" ]]; then
    echo "LaunchDaemon plist present: yes"
  else
    echo "LaunchDaemon plist present: no"
  fi
  if have_sudo && sudo launchctl print "system/${LAUNCHD_LABEL}" >/tmp/killswitch-launchctl.$$ 2>/tmp/killswitch-launchctl-err.$$; then
    awk '
      /state =/ || /pid =/ || /last exit code =/ || /path =/ || /program =/ || /arguments =/ {
        print
      }
    ' /tmp/killswitch-launchctl.$$
  else
    echo "LaunchDaemon not readable without elevated access, or not loaded."
    if [[ -s /tmp/killswitch-launchctl-err.$$ ]]; then
      cat /tmp/killswitch-launchctl-err.$$
    fi
  fi
  rm -f /tmp/killswitch-launchctl.$$ /tmp/killswitch-launchctl-err.$$

  print_header "Anchor File"
  if [[ -r "$ANCHOR_PATH" ]]; then
    cat "$ANCHOR_PATH"
  elif [[ -e "$ANCHOR_PATH" ]]; then
    yellow "Anchor file exists but is not readable. Run with sudo for full details."
  else
    echo "Anchor file does not exist."
  fi

  print_header "Loaded Rules"
  if have_sudo && sudo pfctl -a "$ANCHOR_NAME" -sr >/dev/null 2>&1; then
    sudo pfctl -a "$ANCHOR_NAME" -sr
  else
    echo "Unable to read loaded anchor rules without elevated access. Run with sudo for full details."
  fi
}

cmd_test() {
  local mode target output rc

  echo "Testing simple utun-based kill switch"

  print_header "Setup Health"
  if ! check_setup_health; then
    red "FAIL: Setup health checks failed. Network blocking cannot be trusted."
    return 1
  fi

  if [[ ! -f "$ANCHOR_PATH" ]]; then
    red "FAIL: Anchor file ${ANCHOR_PATH} does not exist"
    return 1
  fi
  echo "PASS: Anchor file exists"

  if ! have_sudo; then
    echo "WARN: Unable to read pf status without elevated access; run with sudo for full pf checks"
  elif sudo pfctl -s info >/dev/null 2>&1; then
    echo "PASS: pf status is readable"
  else
    red "FAIL: Unable to read pf status even with sudo"
    return 1
  fi

  if have_sudo && ! sudo pfctl -a "$ANCHOR_NAME" -sr >/dev/null 2>&1; then
    red "FAIL: Anchor is not loaded in PF, so network blocking cannot work."
    return 1
  fi

  mode="$(current_mode)"
  if [[ -z "$mode" && -e "$ANCHOR_PATH" && ! -r "$ANCHOR_PATH" ]]; then
    yellow "WARN: Anchor mode is not readable without elevated access. Run with sudo for full test results."
    return 1
  fi

  if utun_is_active; then
    if [[ "$mode" == "allow" ]]; then
      echo "PASS: Anchor mode is allow while utun is active"
    else
      red "FAIL: utun is active but anchor mode is ${mode:-unknown}"
      return 1
    fi
  else
    if [[ "$mode" == "block" ]]; then
      echo "PASS: Anchor mode is block while no utun route is active"
    else
      red "FAIL: no utun route is active but anchor mode is ${mode:-unknown}"
      return 1
    fi
  fi

  target="https://1.1.1.1"
  set +e
  output="$(curl -4 -I --silent --show-error --max-time 8 "$target" 2>&1)"
  rc=$?
  set -e

  if utun_is_active; then
    if [[ $rc -eq 0 ]]; then
      echo "PASS: Public internet request succeeded while utun is active"
    else
      echo "WARN: Public internet request failed even though utun is active"
      echo "INFO: curl exit=${rc}: ${output}"
    fi
  else
    if [[ $rc -ne 0 ]]; then
      echo "PASS: Public internet request is blocked/fails while no utun is active"
      echo "INFO: curl exit=${rc}: ${output}"
    else
      red "FAIL: Public internet request succeeded while no utun is active"
      echo "INFO: curl output: ${output}"
      return 1
    fi
  fi
}

main() {
  local command="${1:-}"
  shift || true

  case "$command" in
    enable)
      cmd_enable "$@"
      ;;
    disable)
      cmd_disable "$@"
      ;;
    status)
      cmd_status "$@"
      ;;
    test)
      cmd_test "$@"
      ;;
    __sync)
      cmd_sync_internal "$@"
      ;;
    ""|help|-h|--help)
      usage
      ;;
    *)
      echo "Unknown command: $command" >&2
      usage >&2
      exit 1
      ;;
  esac
}

main "$@"
